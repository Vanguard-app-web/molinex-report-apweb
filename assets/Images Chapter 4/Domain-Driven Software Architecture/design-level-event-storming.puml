@startuml
!include event-storming-style.puml

title Molinex - Design-Level Event Storming Overview
top to bottom direction

rectangle "Commercial Engagement\n[Bounded Context]" as commercial #EDF5FC
rectangle "Identity and Access Management\n[Bounded Context]" as iam #EDF5FC

rectangle "Production Management\n[Bounded Context]" as production #EDF5FC
rectangle "Production Information\nRecorded / Updated\n[Domain Events]" as event_production #FFB26B
rectangle "Quality and Yield Control\n[Bounded Context]" as quality #EDF5FC
rectangle "Quality or Yield\nDeviation Identified\n[Domain Event]" as event_deviation #FFB26B
rectangle "Operational Intelligence\n[Bounded Context]" as intelligence #EDF5FC
rectangle "Operational Anomaly\nDetected\n[Domain Event]" as event_anomaly #FFB26B
rectangle "Asset and Maintenance Management\n[Bounded Context]" as maintenance #EDF5FC
rectangle "Maintenance Recorded\n[Domain Events]" as event_maintenance #FFB26B

rectangle "Rice Mill Sensor Gateway\n[External System]" as external_sensor #F5A3D7
rectangle "Operational Alert\nGenerated\n[Domain Event]" as event_alert #FFB26B
rectangle "Notification Delivery Service\n[External System]" as external_notification #F5A3D7

rectangle "Reporting and Analytics\n[Bounded Context / Read Side]" as reporting #EDF5FC
rectangle "Operational Reports and Trends\n[View / Read Models]" as view_reports #B9D98A

production -right-> event_production
event_production -right-> quality
quality -right-> event_deviation
event_deviation -right-> intelligence
intelligence -right-> event_anomaly
event_anomaly -right-> maintenance
maintenance -right-> event_maintenance

external_sensor -down-> intelligence
intelligence -down-> event_alert
event_alert -down-> external_notification

event_production -down-> reporting
event_deviation -down-> reporting
event_anomaly -down-> reporting
event_maintenance -down-> reporting
reporting -right-> view_reports

commercial -[hidden]right-> iam
commercial -[hidden]down-> production
iam -[hidden]down-> quality

legend bottom
  |= Color |= Element |
  |<#EDF5FC> | Bounded Context |
  |<#FFB26B> | Domain Event |
  |<#F5A3D7> | External System |
  |<#B9D98A> | View / Read Model |
endlegend
@enduml

@startuml
left to right direction
hide empty members

package "Molinex.IdentityAccessManagement.Interfaces.Rest" as Interfaces {
  class AuthenticationController <<REST Controller>> {
    -authenticationService : IAuthenticationService
    --
    +SignIn(resource : SignInResource, cancellationToken : CancellationToken) : Task<IActionResult>
  }
  class UsersController <<REST Controller>> {
    -commandService : IUserCommandService
    -queryService : IUserQueryService
    --
    +Create(resource : CreateUserResource, cancellationToken : CancellationToken) : Task<IActionResult>
    +ChangeStatus(id : long, resource : ChangeAccountStatusResource, cancellationToken : CancellationToken) : Task<IActionResult>
    +GetById(id : long, cancellationToken : CancellationToken) : Task<IActionResult>
    +GetAll(cancellationToken : CancellationToken) : Task<IActionResult>
  }

  class SignInResource <<Request Resource>> <<(R,#FF7700)>> {
    +Email : string
    +Password : string
  }
  class CreateUserResource <<Request Resource>> <<(R,#FF7700)>> {
    +Email : string
    +Password : string
    +FullName : string
    +JobTitle : string
    +PhoneNumber : string
    +Role : string
  }
  class ChangeAccountStatusResource <<Request Resource>> <<(R,#FF7700)>> {
    +Status : string
  }
  class AuthenticatedUserResource <<Response Resource>> <<(R,#FF7700)>> {
    +AccessToken : string
    +UserId : long
    +Role : string
    +Permissions : IReadOnlySet<string>
  }
  class UserResource <<Response Resource>> <<(R,#FF7700)>> {
    +Id : long
    +Email : string
    +FullName : string
    +Role : string
    +Status : string
  }

  class SignInCommandFromResourceAssembler <<Assembler>> {
    +{static} ToCommandFromResource(resource : SignInResource) : SignInCommand
  }
  class CreateUserCommandFromResourceAssembler <<Assembler>> {
    +{static} ToCommandFromResource(resource : CreateUserResource) : CreateUserCommand
  }
  class ChangeAccountStatusCommandFromResourceAssembler <<Assembler>> {
    +{static} ToCommandFromResource(userId : long, resource : ChangeAccountStatusResource) : ChangeAccountStatusCommand
  }
  class AuthenticatedUserResourceFromEntityAssembler <<Assembler>> {
    +{static} ToResourceFromEntity(result : AuthenticationResult) : AuthenticatedUserResource
  }
  class UserResourceFromEntityAssembler <<Assembler>> {
    +{static} ToResourceFromEntity(entity : User) : UserResource
  }
}

package "Molinex.IdentityAccessManagement.Application" as Application {
  interface IAuthenticationService <<Command Service>> {
    +Handle(command : SignInCommand, cancellationToken : CancellationToken) : Task<Result<AuthenticationResult>>
  }
  interface IUserCommandService <<Command Service>> {
    +Handle(command : CreateUserCommand, cancellationToken : CancellationToken) : Task<Result<UserId>>
    +Handle(command : ChangeAccountStatusCommand, cancellationToken : CancellationToken) : Task<Result<UserId>>
  }
  interface IUserQueryService <<Query Service>> {
    +Handle(query : GetUserByIdQuery, cancellationToken : CancellationToken) : Task<User?>
    +Handle(query : GetUsersQuery, cancellationToken : CancellationToken) : Task<IEnumerable<User>>
  }
  interface IHashingService <<Outbound Service>> {
    +HashPassword(password : string) : PasswordHash
    +VerifyPassword(password : string, passwordHash : PasswordHash) : bool
  }
  interface ITokenService <<Outbound Service>> {
    +GenerateToken(principal : AuthenticatedPrincipal) : string
    +ValidateToken(token : string) : Task<AuthenticatedPrincipal?>
  }
  class AuthenticationService <<Command Service>> {
    -repository : IUserRepository
    -hashingService : IHashingService
    -tokenService : ITokenService
  }
  class UserCommandService <<Command Service>> {
    -repository : IUserRepository
    -uniqueEmailPolicy : UniqueEmailPolicy
    -hashingService : IHashingService
    -unitOfWork : IUnitOfWork
  }
  class UserQueryService <<Query Service>> {
    -repository : IUserRepository
  }
  class AuthenticationResult <<Application Result>> {
    +AccessToken : string
    +Principal : AuthenticatedPrincipal
  }
}

package "Molinex.IdentityAccessManagement.Domain.Model.Commands" as Commands {
  class SignInCommand <<Command>> {
    +Email : string
    +Password : string
  }
  class CreateUserCommand <<Command>> {
    +Email : string
    +Password : string
    +FullName : string
    +JobTitle : string
    +PhoneNumber : string
    +Role : string
  }
  class ChangeAccountStatusCommand <<Command>> {
    +UserId : long
    +Status : string
  }
}

package "Molinex.IdentityAccessManagement.Domain.Model.Queries" as Queries {
  class GetUserByIdQuery <<Query>> {
    +UserId : long
  }
  class GetUsersQuery <<Query>>
}

package "Molinex.IdentityAccessManagement.Domain" as Domain {
  class User <<Aggregate Root>> {
    +Id : UserId
    +Email : EmailAddress
    +Credential : PasswordHash
    +Profile : UserProfile
    +Role : Role
    +Status : AccountStatus
    --
    +{static} Register(email, credential, profile, role) : User
    +AssignRole(role : Role) : void
    +UpdateProfile(profile : UserProfile) : void
    +Activate() : void
    +Deactivate() : void
    +Lock() : void
    +ToPrincipal() : AuthenticatedPrincipal
  }
  class UserId <<Value Object>> {
    +Value : long
  }
  class EmailAddress <<Value Object>> {
    +Value : string
    --
    +IsValid() : bool
  }
  class PasswordHash <<Value Object>> {
    +Value : string
  }
  class UserProfile <<Value Object>> {
    +FullName : FullName
    +JobTitle : JobTitle
    +PhoneNumber : PhoneNumber
  }
  class FullName <<Value Object>> {
    +Value : string
  }
  class JobTitle <<Value Object>> {
    +Value : string
  }
  class PhoneNumber <<Value Object>> {
    +Value : string
  }
  class Role <<Value Object>> {
    +Type : RoleType
    +Permissions : IReadOnlySet<Permission>
    --
    +Allows(permission : Permission) : bool
  }
  enum RoleType <<Enumeration>> {
    Administrator
    MaintenanceTechnician
    ProductionOperator
  }
  enum Permission <<Enumeration>> {
    ManageUsers
    ManageProduction
    ManageMaintenance
    ViewOperationalInformation
    ViewReports
  }
  enum AccountStatus <<Enumeration>> {
    Active
    Inactive
    Locked
  }
  class AuthenticatedPrincipal <<Published Language>> {
    +Subject : long
    +Role : string
    +Permissions : IReadOnlySet<string>
  }
  class UniqueEmailPolicy <<Domain Service>> {
    -repository : IUserRepository
    --
    +IsSatisfiedByAsync(email : EmailAddress, cancellationToken : CancellationToken) : Task<bool>
  }
  interface IUserRepository <<Repository>> {
    +FindByEmailAsync(email : EmailAddress, cancellationToken : CancellationToken) : Task<User?>
    +ExistsByEmailAsync(email : EmailAddress, cancellationToken : CancellationToken) : Task<bool>
  }
  class UserRegistered <<Domain Event>> {
    +UserId : UserId
    +OccurredAt : DateTimeOffset
  }
  class AccountStatusChanged <<Domain Event>> {
    +UserId : UserId
    +Status : AccountStatus
    +OccurredAt : DateTimeOffset
  }
}

package "Molinex.IdentityAccessManagement.Infrastructure.Persistence.EntityFrameworkCore" as Infrastructure {
  class UserRepository <<EF Core Repository>> {
    +FindByEmailAsync(email : EmailAddress, cancellationToken : CancellationToken) : Task<User?>
    +ExistsByEmailAsync(email : EmailAddress, cancellationToken : CancellationToken) : Task<bool>
  }
  class ModelBuilderExtensions <<EF Core Configuration>> {
    +{static} ApplyIdentityAccessManagementConfiguration(builder : ModelBuilder) : void
  }
}

package "Molinex.IdentityAccessManagement.Infrastructure.Hashing.BCrypt" as Hashing {
  class HashingService <<BCrypt Hashing Service>> {
    +HashPassword(password : string) : PasswordHash
    +VerifyPassword(password : string, passwordHash : PasswordHash) : bool
  }
}

package "Molinex.IdentityAccessManagement.Infrastructure.Tokens.Jwt" as Tokens {
  class TokenService <<JWT Token Service>> {
    -tokenSettings : TokenSettings
    --
    +GenerateToken(principal : AuthenticatedPrincipal) : string
    +ValidateToken(token : string) : Task<AuthenticatedPrincipal?>
  }
  class TokenSettings <<Settings>> {
    +Secret : string
  }
}

package "Molinex.IdentityAccessManagement.Infrastructure.Pipeline.Middleware" as Pipeline {
  class RequestAuthorizationMiddleware <<Middleware>> {
    -next : RequestDelegate
    --
    +InvokeAsync(context : HttpContext, userQueryService : IUserQueryService, tokenService : ITokenService) : Task
  }
  class AuthorizeAttribute <<Authorization Filter>> {
    +OnAuthorization(context : AuthorizationFilterContext) : void
  }
  class AllowAnonymousAttribute <<Attribute>>
}

package "Molinex.Shared (reference)" as SharedReference {
  abstract class AggregateRoot <<Shared Base Aggregate>>
  interface IEntityId<T> <<Shared Identifier Contract>>
  interface IEvent <<Shared Event Contract>>
  interface IBaseRepository<TEntity> <<Shared Repository>>
  abstract class BaseRepository<TEntity> <<Shared EF Core Repository>>
  interface IUnitOfWork <<Shared Unit of Work>>
  class Result<T> <<Shared Application Result>>
  class Error <<Shared Value Object>>
}


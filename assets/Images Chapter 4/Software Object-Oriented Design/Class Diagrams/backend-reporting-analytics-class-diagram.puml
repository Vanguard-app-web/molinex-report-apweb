@startuml
left to right direction
hide empty members

package "Molinex.ReportingAnalytics.Interfaces.Rest" as Interfaces {
  class ReportsController <<REST Controller>> {
    -queryService : IReportingQueryService
    --
    +GetOperationalSummary(start : DateOnly, end : DateOnly, cancellationToken : CancellationToken) : Task<IActionResult>
    +GetProductionReport(start : DateOnly, end : DateOnly, cancellationToken : CancellationToken) : Task<IActionResult>
    +GetMaintenanceReport(start : DateOnly, end : DateOnly, cancellationToken : CancellationToken) : Task<IActionResult>
    +GetOperationalTrend(indicator : string, start : DateOnly, end : DateOnly, cancellationToken : CancellationToken) : Task<IActionResult>
  }

  class OperationalSummaryResource <<Response Resource>> <<(R,#FF7700)>> {
    +Start : DateOnly
    +End : DateOnly
    +Metrics : IReadOnlyCollection<MetricResource>
  }
  class ReportResource <<Response Resource>> <<(R,#FF7700)>> {
    +Start : DateOnly
    +End : DateOnly
    +Rows : IReadOnlyCollection<ReportRowResource>
  }
  class OperationalTrendResource <<Response Resource>> <<(R,#FF7700)>> {
    +Indicator : string
    +Points : IReadOnlyCollection<TrendPointResource>
  }
  class MetricResource <<Response Resource>> <<(R,#FF7700)>> {
    +Name : string
    +Value : decimal
    +Unit : string
  }
  class ReportRowResource <<Response Resource>> <<(R,#FF7700)>> {
    +Dimensions : IReadOnlyDictionary<string, string>
    +Metrics : IReadOnlyCollection<MetricResource>
  }
  class TrendPointResource <<Response Resource>> <<(R,#FF7700)>> {
    +RecordedAt : DateTimeOffset
    +Value : decimal
  }

  class OperationalSummaryResourceFromEntityAssembler <<Assembler>> {
    +{static} ToResourceFromEntity(entity : OperationalSummary) : OperationalSummaryResource
  }
  class ReportResourceFromEntityAssembler <<Assembler>> {
    +{static} ToResourceFromEntity(entity : ProductionReport) : ReportResource
    +{static} ToResourceFromEntity(entity : MaintenanceReport) : ReportResource
  }
  class OperationalTrendResourceFromEntityAssembler <<Assembler>> {
    +{static} ToResourceFromEntity(entity : OperationalTrend) : OperationalTrendResource
  }
}

package "Molinex.ReportingAnalytics.Application" as Application {
  interface IReportingQueryService <<Query Service>> {
    +Handle(query : GetOperationalSummaryQuery, cancellationToken : CancellationToken) : Task<OperationalSummary>
    +Handle(query : GenerateProductionReportQuery, cancellationToken : CancellationToken) : Task<ProductionReport>
    +Handle(query : GenerateMaintenanceReportQuery, cancellationToken : CancellationToken) : Task<MaintenanceReport>
    +Handle(query : GetOperationalTrendQuery, cancellationToken : CancellationToken) : Task<OperationalTrend>
  }
  interface IReportingProjectionService <<Projection Service>> {
    +Handle(publishedEvent : PublishedDomainEvent, cancellationToken : CancellationToken) : Task<Result<ProjectionMetricId>>
  }
  class ReportingQueryService <<Query Service>> {
    -projectionRepository : IReportingProjectionRepository
  }
  class ReportingProjectionService <<Projection Service>> {
    -projectionRepository : IReportingProjectionRepository
    -unitOfWork : IUnitOfWork
  }
  class ReportingProjectionHandler <<Event Handler>> {
    -projectionService : IReportingProjectionService
    --
    +Handle(publishedEvent : PublishedDomainEvent, cancellationToken : CancellationToken) : Task
  }
}

package "Molinex.ReportingAnalytics.Domain.Model.Queries" as Queries {
  class GetOperationalSummaryQuery <<Query>> {
    +Start : DateOnly
    +End : DateOnly
  }
  class GenerateProductionReportQuery <<Query>> {
    +Start : DateOnly
    +End : DateOnly
  }
  class GenerateMaintenanceReportQuery <<Query>> {
    +Start : DateOnly
    +End : DateOnly
  }
  class GetOperationalTrendQuery <<Query>> {
    +Indicator : string
    +Start : DateOnly
    +End : DateOnly
  }
}

package "Molinex.ReportingAnalytics.Domain" as Domain {
  class ProjectionMetricId <<Value Object>> {
    +Value : long
  }
  class DateRange <<Value Object>> {
    +Start : DateOnly
    +End : DateOnly
    --
    +IsValid() : bool
  }
  class MetricName <<Value Object>> {
    +Value : string
  }
  class MetricValue <<Value Object>> {
    +Name : MetricName
    +Value : decimal
    +Unit : string
    +MeasuredAt : DateTimeOffset
  }
  class ReportRow <<Value Object>> {
    +Dimensions : IReadOnlyDictionary<string, string>
    +Metrics : IReadOnlyCollection<MetricValue>
  }
  class TrendPoint <<Value Object>> {
    +RecordedAt : DateTimeOffset
    +Value : decimal
  }
  class OperationalSummary <<Read Model>> {
    +Period : DateRange
    +Metrics : IReadOnlyCollection<MetricValue>
  }
  class ProductionReport <<Read Model>> {
    +Period : DateRange
    +Rows : IReadOnlyCollection<ReportRow>
  }
  class MaintenanceReport <<Read Model>> {
    +Period : DateRange
    +Rows : IReadOnlyCollection<ReportRow>
  }
  class OperationalTrend <<Read Model>> {
    +Indicator : MetricName
    +Period : DateRange
    +Points : IReadOnlyCollection<TrendPoint>
  }
  class PublishedDomainEvent <<Published Language>> {
    +EventName : string
    +SourceContext : string
    +AggregateReference : long
    +OccurredAt : DateTimeOffset
    +PayloadVersion : int
    +Payload : IReadOnlyDictionary<string, string>
  }
  class MetricProjection <<Projection Model>> {
    +Id : ProjectionMetricId
    +SourceContext : string
    +SourceAggregateId : long
    +Category : ReportCategory
    +Metric : MetricValue
    +Dimensions : IReadOnlyDictionary<string, string>
  }
  enum ReportCategory <<Enumeration>> {
    Operational
    Production
    Quality
    Maintenance
  }
  interface IReportingProjectionRepository <<Repository>> {
    +FindMetricsAsync(period : DateRange, cancellationToken : CancellationToken) : Task<IEnumerable<MetricProjection>>
    +FindByCategoryAsync(category : ReportCategory, period : DateRange, cancellationToken : CancellationToken) : Task<IEnumerable<MetricProjection>>
    +FindTrendAsync(indicator : MetricName, period : DateRange, cancellationToken : CancellationToken) : Task<IEnumerable<MetricProjection>>
  }
}

package "Molinex.ReportingAnalytics.Infrastructure.Persistence.EntityFrameworkCore" as Infrastructure {
  class ReportingProjectionRepository <<EF Core Repository>> {
    +FindMetricsAsync(period : DateRange, cancellationToken : CancellationToken) : Task<IEnumerable<MetricProjection>>
    +FindByCategoryAsync(category : ReportCategory, period : DateRange, cancellationToken : CancellationToken) : Task<IEnumerable<MetricProjection>>
    +FindTrendAsync(indicator : MetricName, period : DateRange, cancellationToken : CancellationToken) : Task<IEnumerable<MetricProjection>>
  }
  class ModelBuilderExtensions <<EF Core Configuration>> {
    +{static} ApplyReportingAnalyticsConfiguration(builder : ModelBuilder) : void
  }
}

package "Molinex.ReportingAnalytics.Infrastructure.Messaging" as Messaging {
  class DomainEventMessageHandler <<Event Handler>> {
    -mediator : IMediator
    --
    +Handle(message : DomainEventMessage, cancellationToken : CancellationToken) : Task
  }
  class DomainEventMessage <<Integration Message>> {
    +EventName : string
    +SourceContext : string
    +AggregateReference : long
    +OccurredAt : DateTimeOffset
    +PayloadVersion : int
    +Payload : IReadOnlyDictionary<string, string>
  }
  class PublishedDomainEventAssembler <<Anti-Corruption Layer>> {
    +{static} ToPublishedLanguage(message : DomainEventMessage) : PublishedDomainEvent
  }
}


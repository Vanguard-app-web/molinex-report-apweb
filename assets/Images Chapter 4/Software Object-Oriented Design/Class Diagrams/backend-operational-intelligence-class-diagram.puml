package "Molinex.OperationalIntelligence.Interfaces.Rest" as Interfaces {
  class OperationalReadingsController <<Integration Controller>> {
    -commandService : IIntelligenceCommandService
    -queryService : IIntelligenceQueryService
    --
    +Ingest(resource : SensorReadingResource, cancellationToken : CancellationToken) : Task<IActionResult>
    +GetHistory(cancellationToken : CancellationToken) : Task<IActionResult>
  }
  class AnomaliesController <<REST Controller>> {
    -commandService : IIntelligenceCommandService
    -queryService : IIntelligenceQueryService
    --
    +GetAll(cancellationToken : CancellationToken) : Task<IActionResult>
    +Acknowledge(id : long, cancellationToken : CancellationToken) : Task<IActionResult>
  }
  class AlertsController <<REST Controller>> {
    -commandService : IIntelligenceCommandService
    -queryService : IIntelligenceQueryService
    --
    +GetAll(cancellationToken : CancellationToken) : Task<IActionResult>
    +Acknowledge(id : long, cancellationToken : CancellationToken) : Task<IActionResult>
    +Close(id : long, cancellationToken : CancellationToken) : Task<IActionResult>
  }

  class SensorReadingResource <<Request Resource>> <<(R,#FF7700)>> {
    +MachineId : long
    +VariableName : string
    +Value : decimal
    +UnitSymbol : string
    +RecordedAt : DateTimeOffset
  }
  class OperationalReadingResource <<Response Resource>> <<(R,#FF7700)>> {
    +Id : long
    +MachineId : long
    +VariableName : string
    +Value : decimal
    +UnitSymbol : string
    +RecordedAt : DateTimeOffset
  }
  class AnomalyResource <<Response Resource>> <<(R,#FF7700)>> {
    +Id : long
    +ReadingId : long
    +VariableName : string
    +Value : decimal
    +UnitSymbol : string
    +Status : string
    +DetectedAt : DateTimeOffset
  }
  class AlertResource <<Response Resource>> <<(R,#FF7700)>> {
    +Id : long
    +AnomalyId : long
    +Priority : string
    +Status : string
    +GeneratedAt : DateTimeOffset
  }

  class RegisterOperationalReadingCommandFromResourceAssembler <<Assembler>> {
    +{static} ToCommandFromResource(resource : SensorReadingResource) : RegisterOperationalReadingCommand
  }
  class OperationalReadingResourceFromEntityAssembler <<Assembler>> {
    +{static} ToResourceFromEntity(entity : OperationalReading) : OperationalReadingResource
  }
  class AnomalyResourceFromEntityAssembler <<Assembler>> {
    +{static} ToResourceFromEntity(entity : OperationalAnomaly) : AnomalyResource
  }
  class AlertResourceFromEntityAssembler <<Assembler>> {
    +{static} ToResourceFromEntity(entity : Alert) : AlertResource
  }
}

package "Molinex.OperationalIntelligence.Application" as Application {
  interface IIntelligenceCommandService <<Command Service>> {
    +Handle(command : RegisterOperationalReadingCommand, cancellationToken : CancellationToken) : Task<Result<OperationalReadingId>>
    +Handle(command : AcknowledgeAnomalyCommand, cancellationToken : CancellationToken) : Task<Result<OperationalAnomalyId>>
    +Handle(command : AttendAlertCommand, cancellationToken : CancellationToken) : Task<Result<AlertId>>
  }
  interface IIntelligenceQueryService <<Query Service>> {
    +Handle(query : GetOperationalReadingsQuery, cancellationToken : CancellationToken) : Task<IEnumerable<OperationalReading>>
    +Handle(query : GetOperationalAnomaliesQuery, cancellationToken : CancellationToken) : Task<IEnumerable<OperationalAnomaly>>
    +Handle(query : GetAlertsQuery, cancellationToken : CancellationToken) : Task<IEnumerable<Alert>>
    +Handle(query : GetMaintenanceRecommendationsQuery, cancellationToken : CancellationToken) : Task<IEnumerable<MaintenanceRecommendation>>
  }
  interface INotificationPort <<Port>> {
    +SendOperationalAlertAsync(alert : Alert, cancellationToken : CancellationToken) : Task
  }
  class IntelligenceCommandService <<Command Service>> {
    -readingRepository : IOperationalReadingRepository
    -anomalyRepository : IOperationalAnomalyRepository
    -alertRepository : IAlertRepository
    -notificationPort : INotificationPort
    -detectionService : AnomalyDetectionService
    -unitOfWork : IUnitOfWork
  }
  class IntelligenceQueryService <<Query Service>> {
    -readingRepository : IOperationalReadingRepository
    -anomalyRepository : IOperationalAnomalyRepository
    -alertRepository : IAlertRepository
  }
}


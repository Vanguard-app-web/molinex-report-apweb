package "Molinex.CommercialEngagement.Interfaces.Rest" as Interfaces {
  class CommercialInquiriesController <<REST Controller>> {
    -commandService : ICommercialCommandService
    -queryService : ICommercialQueryService
    --
    +Submit(resource : SubmitCommercialInquiryResource, cancellationToken : CancellationToken) : Task<IActionResult>
    +GetById(id : long, cancellationToken : CancellationToken) : Task<IActionResult>
    +GetAll(status : string?, cancellationToken : CancellationToken) : Task<IActionResult>
  }
  class CommercialContentController <<REST Controller>> {
    -queryService : ICommercialQueryService
    --
    +GetPlans(cancellationToken : CancellationToken) : Task<IActionResult>
    +GetValueProposition(cancellationToken : CancellationToken) : Task<IActionResult>
  }

  class SubmitCommercialInquiryResource <<Request Resource>> <<(R,#FF7700)>> {
    +FullName : string
    +Email : string
    +Phone : string?
    +CompanyName : string
    +Message : string
  }
  class CommercialInquiryResource <<Response Resource>> <<(R,#FF7700)>> {
    +Id : long
    +FullName : string
    +Email : string
    +Status : string
    +SubmittedAt : DateTimeOffset
  }
  class PlanSummaryResource <<Response Resource>> <<(R,#FF7700)>> {
    +Code : string
    +Name : string
    +PriceLabel : string
    +Features : IReadOnlyCollection<string>
  }
  class ValuePropositionResource <<Response Resource>> <<(R,#FF7700)>> {
    +Headline : string
    +Description : string
    +Benefits : IReadOnlyCollection<string>
  }

  class SubmitCommercialInquiryCommandFromResourceAssembler <<Assembler>> {
    +{static} ToCommandFromResource(resource : SubmitCommercialInquiryResource) : SubmitCommercialInquiryCommand
  }
  class CommercialInquiryResourceFromEntityAssembler <<Assembler>> {
    +{static} ToResourceFromEntity(entity : CommercialInquiry) : CommercialInquiryResource
  }
  class PlanSummaryResourceFromEntityAssembler <<Assembler>> {
    +{static} ToResourceFromEntity(entity : PlanSummary) : PlanSummaryResource
  }
  class ValuePropositionResourceFromEntityAssembler <<Assembler>> {
    +{static} ToResourceFromEntity(entity : ValueProposition) : ValuePropositionResource
  }
}

package "Molinex.CommercialEngagement.Application" as Application {
  interface ICommercialCommandService <<Command Service>> {
    +Handle(command : SubmitCommercialInquiryCommand, cancellationToken : CancellationToken) : Task<Result<CommercialInquiryId>>
    +Handle(command : ChangeInquiryStatusCommand, cancellationToken : CancellationToken) : Task<Result<CommercialInquiryId>>
  }
  interface ICommercialQueryService <<Query Service>> {
    +Handle(query : GetCommercialInquiryByIdQuery, cancellationToken : CancellationToken) : Task<CommercialInquiry?>
    +Handle(query : GetCommercialInquiriesQuery, cancellationToken : CancellationToken) : Task<IEnumerable<CommercialInquiry>>
    +Handle(query : GetPlanCatalogQuery, cancellationToken : CancellationToken) : Task<IEnumerable<PlanSummary>>
    +Handle(query : GetValuePropositionQuery, cancellationToken : CancellationToken) : Task<ValueProposition>
  }
  interface ICommercialContentService <<Outbound Service>> {
    +FindPlanCatalogAsync(cancellationToken : CancellationToken) : Task<IEnumerable<PlanSummary>>
    +FindValuePropositionAsync(cancellationToken : CancellationToken) : Task<ValueProposition>
  }
  class CommercialCommandService <<Command Service>> {
    -repository : ICommercialInquiryRepository
    -unitOfWork : IUnitOfWork
  }
  class CommercialQueryService <<Query Service>> {
    -repository : ICommercialInquiryRepository
    -contentService : ICommercialContentService
  }
}


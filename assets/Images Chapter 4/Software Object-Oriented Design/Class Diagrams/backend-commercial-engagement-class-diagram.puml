package "Molinex.CommercialEngagement.Domain" as Domain {
  class CommercialInquiry <<Aggregate Root>> {
    +Id : CommercialInquiryId
    +Contact : ContactInformation
    +Message : InquiryMessage
    +Status : InquiryStatus
    +SubmittedAt : SubmissionDateTime
    --
    +{static} Submit(contact, message, submittedAt) : CommercialInquiry
    +MarkAsContacted() : void
    +Close() : void
  }
  class CommercialInquiryId <<Value Object>> {
    +Value : long
  }
  class ContactInformation <<Value Object>> {
    +FullName : FullName
    +Email : EmailAddress
    +Phone : PhoneNumber?
    +CompanyName : CompanyName
  }
  class FullName <<Value Object>> {
    +Value : string
  }
  class EmailAddress <<Value Object>> {
    +Value : string
    --
    +IsValid() : bool
  }
  class PhoneNumber <<Value Object>> {
    +Value : string
    --
    +IsValid() : bool
  }
  class CompanyName <<Value Object>> {
    +Value : string
  }
  class InquiryMessage <<Value Object>> {
    +Value : string
    --
    +IsBlank() : bool
  }
  class SubmissionDateTime <<Value Object>> {
    +Value : DateTimeOffset
  }
  enum InquiryStatus <<Enumeration>> {
    Submitted
    Contacted
    Closed
  }
  class PlanSummary <<Read Model>> {
    +Code : string
    +Name : string
    +PriceLabel : string
    +Features : IReadOnlyCollection<string>
    +Conditions : IReadOnlyCollection<string>
  }
  class ValueProposition <<Read Model>> {
    +Headline : string
    +Description : string
    +Benefits : IReadOnlyCollection<string>
  }
  interface ICommercialInquiryRepository <<Repository>> {
    +FindByStatusAsync(status : InquiryStatus, cancellationToken : CancellationToken) : Task<IEnumerable<CommercialInquiry>>
  }
  class CommercialInquirySubmitted <<Domain Event>> {
    +InquiryId : CommercialInquiryId
    +OccurredAt : DateTimeOffset
  }
  class CommercialInquiryStatusChanged <<Domain Event>> {
    +InquiryId : CommercialInquiryId
    +Status : InquiryStatus
    +OccurredAt : DateTimeOffset
  }
}


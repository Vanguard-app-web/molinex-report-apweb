@startuml
left to right direction
hide empty members

package "Molinex.QualityYieldControl.Interfaces.Rest" as Interfaces {
  class QualityAssessmentsController <<REST Controller>> {
    -commandService : IQualityCommandService
    -queryService : IQualityQueryService
    --
    +Create(resource : CreateQualityAssessmentResource, cancellationToken : CancellationToken) : Task<IActionResult>
    +GetById(id : long, cancellationToken : CancellationToken) : Task<IActionResult>
  }
  class WasteRecordsController <<REST Controller>> {
    -commandService : IQualityCommandService
    -queryService : IQualityQueryService
    --
    +Create(resource : CreateWasteRecordResource, cancellationToken : CancellationToken) : Task<IActionResult>
    +GetAll(cancellationToken : CancellationToken) : Task<IActionResult>
  }
  class YieldIndicatorsController <<REST Controller>> {
    -queryService : IQualityQueryService
    --
    +GetIndicators(cancellationToken : CancellationToken) : Task<IActionResult>
    +Compare(cancellationToken : CancellationToken) : Task<IActionResult>
    +GetDeviations(cancellationToken : CancellationToken) : Task<IActionResult>
  }

  class CreateQualityAssessmentResource <<Request Resource>> <<(R,#FF7700)>> {
    +ProductionRecordId : long
    +Measurements : IReadOnlyCollection<QualityMeasurementResource>
    +AssessedAt : DateTimeOffset
  }
  class QualityMeasurementResource <<Resource>> <<(R,#FF7700)>> {
    +Indicator : string
    +Value : decimal
    +ExpectedMinimum : decimal
    +ExpectedMaximum : decimal
  }
  class CreateWasteRecordResource <<Request Resource>> <<(R,#FF7700)>> {
    +ProductionRecordId : long
    +QuantityValue : decimal
    +QuantityUnit : string
    +BaseWeightValue : decimal
    +RecordedAt : DateTimeOffset
  }
  class QualityAssessmentResource <<Response Resource>> <<(R,#FF7700)>> {
    +Id : long
    +ProductionRecordId : long
    +Measurements : IReadOnlyCollection<QualityMeasurementResource>
    +AssessedAt : DateTimeOffset
  }
  class WasteRecordResource <<Response Resource>> <<(R,#FF7700)>> {
    +Id : long
    +ProductionRecordId : long
    +QuantityValue : decimal
    +QuantityUnit : string
    +BaseWeightValue : decimal
    +Percentage : decimal
    +RecordedAt : DateTimeOffset
  }
  class YieldIndicatorResource <<Response Resource>> <<(R,#FF7700)>> {
    +Name : string
    +Value : decimal
  }
  class QualityComparisonResource <<Response Resource>> <<(R,#FF7700)>> {
    +Current : decimal
    +Previous : decimal
  }
  class QualityDeviationResource <<Response Resource>> <<(R,#FF7700)>> {
    +Id : long
    +SourceId : long
    +SourceType : string
    +Indicator : string
    +ObservedValue : decimal
    +DetectedAt : DateTimeOffset
  }

  class RecordQualityAssessmentCommandFromResourceAssembler <<Assembler>> {
    +{static} ToCommandFromResource(resource : CreateQualityAssessmentResource) : RecordQualityAssessmentCommand
  }
  class RecordWasteCommandFromResourceAssembler <<Assembler>> {
    +{static} ToCommandFromResource(resource : CreateWasteRecordResource) : RecordWasteCommand
  }
  class QualityAssessmentResourceFromEntityAssembler <<Assembler>> {
    +{static} ToResourceFromEntity(entity : QualityAssessment) : QualityAssessmentResource
  }
  class WasteRecordResourceFromEntityAssembler <<Assembler>> {
    +{static} ToResourceFromEntity(entity : WasteRecord) : WasteRecordResource
  }
  class YieldIndicatorResourceFromEntityAssembler <<Assembler>> {
    +{static} ToResourceFromEntity(entity : YieldIndicator) : YieldIndicatorResource
  }
  class QualityComparisonResourceFromEntityAssembler <<Assembler>> {
    +{static} ToResourceFromEntity(entity : QualityComparison) : QualityComparisonResource
  }
  class QualityDeviationResourceFromEntityAssembler <<Assembler>> {
    +{static} ToResourceFromEntity(entity : QualityDeviation) : QualityDeviationResource
  }
}

package "Molinex.QualityYieldControl.Application" as Application {
  interface IQualityCommandService <<Command Service>> {
    +Handle(command : RecordQualityAssessmentCommand, cancellationToken : CancellationToken) : Task<Result<QualityAssessmentId>>
    +Handle(command : RecordWasteCommand, cancellationToken : CancellationToken) : Task<Result<WasteRecordId>>
    +Handle(command : IdentifyQualityDeviationCommand, cancellationToken : CancellationToken) : Task<Result<QualityDeviationId>>
  }
  interface IQualityQueryService <<Query Service>> {
    +Handle(query : GetQualityAssessmentByIdQuery, cancellationToken : CancellationToken) : Task<QualityAssessment?>
    +Handle(query : GetYieldIndicatorsQuery, cancellationToken : CancellationToken) : Task<IEnumerable<YieldIndicator>>
    +Handle(query : CompareQualityIndicatorsQuery, cancellationToken : CancellationToken) : Task<QualityComparison>
    +Handle(query : GetQualityDeviationsQuery, cancellationToken : CancellationToken) : Task<IEnumerable<QualityDeviation>>
  }
  class QualityCommandService <<Command Service>> {
    -assessmentRepository : IQualityAssessmentRepository
    -wasteRepository : IWasteRecordRepository
    -deviationRepository : IQualityDeviationRepository
    -externalProductionService : IExternalProductionService
    -unitOfWork : IUnitOfWork
  }
  class QualityQueryService <<Query Service>> {
    -assessmentRepository : IQualityAssessmentRepository
    -wasteRepository : IWasteRecordRepository
    -deviationRepository : IQualityDeviationRepository
    -externalProductionService : IExternalProductionService
  }
}

package "Molinex.QualityYieldControl.Domain.Model.Commands" as Commands {
  class RecordQualityAssessmentCommand <<Command>> {
    +ProductionRecordId : long
    +Measurements : IReadOnlyCollection<QualityMeasurementData>
    +AssessedAt : DateTimeOffset
  }
  class QualityMeasurementData <<Command Data>> {
    +Indicator : string
    +Value : decimal
    +ExpectedMinimum : decimal
    +ExpectedMaximum : decimal
  }
  class RecordWasteCommand <<Command>> {
    +ProductionRecordId : long
    +QuantityValue : decimal
    +QuantityUnit : string
    +BaseWeightValue : decimal
    +RecordedAt : DateTimeOffset
  }
  class IdentifyQualityDeviationCommand <<Command>> {
    +SourceId : long
    +SourceType : string
    +Indicator : string
    +ObservedValue : decimal
  }
}

package "Molinex.QualityYieldControl.Domain.Model.Queries" as Queries {
  class GetQualityAssessmentByIdQuery <<Query>> {
    +Id : long
  }
  class GetYieldIndicatorsQuery <<Query>>
  class CompareQualityIndicatorsQuery <<Query>>
  class GetQualityDeviationsQuery <<Query>>
}

package "Molinex.QualityYieldControl.Domain" as Domain {
  class QualityAssessment <<Aggregate Root>> {
    +Id : QualityAssessmentId
    +ProductionRecordId : ProductionRecordId
    +Measurements : IReadOnlyCollection<QualityMeasurement>
    +AssessedAt : AssessmentDateTime
    --
    +RecordMeasurement(measurement : QualityMeasurement) : void
    +HasValidPercentages() : bool
  }
  class WasteRecord <<Aggregate Root>> {
    +Id : WasteRecordId
    +ProductionRecordId : ProductionRecordId
    +Quantity : Weight
    +BaseWeight : Weight
    +Percentage : Percentage
    +RecordedAt : WasteRecordDateTime
    --
    +CalculatePercentage() : Percentage
  }
  class QualityDeviation <<Aggregate Root>> {
    +Id : QualityDeviationId
    +Source : DeviationSource
    +Measurement : QualityMeasurement
    +DetectedAt : DetectionDateTime
  }

  class QualityAssessmentId <<Value Object>> {
    +Value : long
  }
  class WasteRecordId <<Value Object>> {
    +Value : long
  }
  class QualityDeviationId <<Value Object>> {
    +Value : long
  }
  class ProductionRecordId <<Value Object>> {
    +Value : long
  }
  class ProductionRecordReference <<Value Object>> {
    +Id : ProductionRecordId
    +ProductionBatchId : long
    +ProcessedWeight : Weight
    +StartedAt : DateTimeOffset
  }
  class AssessmentDateTime <<Value Object>> {
    +Value : DateTimeOffset
  }
  class WasteRecordDateTime <<Value Object>> {
    +Value : DateTimeOffset
  }
  class DetectionDateTime <<Value Object>> {
    +Value : DateTimeOffset
  }
  class Percentage <<Value Object>> {
    +Value : decimal
    --
    +IsValid() : bool
  }
  class QualityRange <<Value Object>> {
    +Minimum : Percentage
    +Maximum : Percentage
    --
    +Contains(value : Percentage) : bool
  }
  class QualityMeasurement <<Value Object>> {
    +Indicator : QualityIndicator
    +Value : Percentage
    +ExpectedRange : QualityRange
    --
    +IsOutsideExpectedRange() : bool
  }
  class DeviationSource <<Value Object>> {
    +SourceId : long
    +SourceType : DeviationSourceType
  }
  class YieldIndicator <<Read Model>> {
    +Name : string
    +Value : Percentage
  }
  class QualityComparison <<Read Model>> {
    +Current : Percentage
    +Previous : Percentage
  }
  enum QualityIndicator <<Enumeration>> {
    WholeGrainPercentage
    BrokenGrainPercentage
    YieldPercentage
  }
  enum DeviationSourceType <<Enumeration>> {
    QualityAssessment
    WasteRecord
  }

  interface IQualityAssessmentRepository <<Repository>>
  interface IWasteRecordRepository <<Repository>>
  interface IQualityDeviationRepository <<Repository>>

  class QualityAssessmentRecorded <<Domain Event>> {
    +AssessmentId : QualityAssessmentId
    +OccurredAt : DateTimeOffset
  }
  class WasteRecorded <<Domain Event>> {
    +WasteRecordId : WasteRecordId
    +OccurredAt : DateTimeOffset
  }
  class QualityDeviationIdentified <<Domain Event>> {
    +DeviationId : QualityDeviationId
    +OccurredAt : DateTimeOffset
  }
}

package "Molinex.QualityYieldControl.Infrastructure.Persistence.EntityFrameworkCore" as Infrastructure {
  class QualityAssessmentRepository <<EF Core Repository>>
  class WasteRecordRepository <<EF Core Repository>>
  class QualityDeviationRepository <<EF Core Repository>>
  class ModelBuilderExtensions <<EF Core Configuration>> {
    +{static} ApplyQualityYieldControlConfiguration(builder : ModelBuilder) : void
  }
}

package "Molinex.QualityYieldControl.Application.OutboundServices.Acl" as OutboundAcl {
  interface IExternalProductionService <<ACL>> {
    +ExistsProductionRecord(productionRecordId : ProductionRecordId, cancellationToken : CancellationToken) : Task<bool>
    +ExistsProductionBatch(productionBatchId : long, cancellationToken : CancellationToken) : Task<bool>
    +FetchProductionRecord(productionRecordId : ProductionRecordId, cancellationToken : CancellationToken) : Task<ProductionRecordReference?>
    +FetchProductionRecords(productionBatchId : long?, from : DateTimeOffset?, to : DateTimeOffset?, cancellationToken : CancellationToken) : Task<IReadOnlyList<ProductionRecordReference>>
  }
}

package "Molinex.QualityYieldControl.Application.Internal.OutboundServices.Acl" as InternalAcl {
  class ExternalProductionService <<ACL>> {
    -productionContextFacade : IProductionContextFacade
    --
    -{static} ToReference(summary : ProductionRecordSummary) : ProductionRecordReference
  }
}

package "Molinex.ProductionManagement.Interfaces.Acl (provider, reference)" as ProductionAcl {
  interface IProductionContextFacade <<Facade>> {
    +ExistsProductionRecordById(productionRecordId : long, cancellationToken : CancellationToken) : Task<bool>
    +ExistsProductionBatchById(productionBatchId : long, cancellationToken : CancellationToken) : Task<bool>
    +FetchProductionRecordById(productionRecordId : long, cancellationToken : CancellationToken) : Task<ProductionRecordSummary?>
    +FetchProductionRecords(productionBatchId : long?, from : DateTimeOffset?, to : DateTimeOffset?, cancellationToken : CancellationToken) : Task<IReadOnlyList<ProductionRecordSummary>>
  }
  class ProductionRecordSummary <<Read Contract>> {
    +ProductionRecordId : long
    +ProductionBatchId : long
    +ProcessedWeightValue : decimal
    +ProcessedWeightUnit : string
    +StartedAt : DateTimeOffset
  }
}

package "Molinex.Shared (reference)" as SharedReference {
  abstract class AggregateRoot <<Shared Base Aggregate>>
  interface IEntityId<T> <<Shared Identifier Contract>>
  interface IEvent <<Shared Event Contract>>
  interface IBaseRepository<TEntity> <<Shared Repository>>
  abstract class BaseRepository<TEntity> <<Shared EF Core Repository>>
  interface IUnitOfWork <<Shared Unit of Work>>
  class Result<T> <<Shared Application Result>>
  class Error <<Shared Value Object>>
  class Weight <<Shared Value Object>>
  enum MeasurementUnit <<Enumeration>> {
    Kilogram
    MetricTon
  }
}


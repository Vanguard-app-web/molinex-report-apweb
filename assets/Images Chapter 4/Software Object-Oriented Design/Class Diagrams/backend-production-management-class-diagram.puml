package "Molinex.ProductionManagement.Application" as Application {
  interface IProductionCommandService <<Command Service>> {
    +Handle(command : RecordRawMaterialReceptionCommand, cancellationToken : CancellationToken) : Task<Result<RawMaterialReceptionId>>
    +Handle(command : RegisterProductionBatchCommand, cancellationToken : CancellationToken) : Task<Result<ProductionBatchId>>
    +Handle(command : RecordProductionInformationCommand, cancellationToken : CancellationToken) : Task<Result<ProductionRecordId>>
    +Handle(command : UpdateProductionInformationCommand, cancellationToken : CancellationToken) : Task<Result<ProductionRecordId>>
  }
  interface IProductionQueryService <<Query Service>> {
    +Handle(query : GetRawMaterialReceptionByIdQuery, cancellationToken : CancellationToken) : Task<RawMaterialReception?>
    +Handle(query : GetAvailableProductionBatchesQuery, cancellationToken : CancellationToken) : Task<IEnumerable<ProductionBatch>>
    +Handle(query : GetProductionHistoryQuery, cancellationToken : CancellationToken) : Task<IEnumerable<ProductionRecord>>
  }
  class ProductionCommandService <<Command Service>> {
    -receptionRepository : IRawMaterialReceptionRepository
    -batchRepository : IProductionBatchRepository
    -recordRepository : IProductionRecordRepository
    -unitOfWork : IUnitOfWork
  }
  class ProductionQueryService <<Query Service>> {
    -receptionRepository : IRawMaterialReceptionRepository
    -batchRepository : IProductionBatchRepository
    -recordRepository : IProductionRecordRepository
  }
}


package "Molinex.AssetMaintenanceManagement.Interfaces.Rest" as Interfaces {
  class MachinesController <<REST Controller>> {
    -commandService : IMaintenanceCommandService
    -queryService : IMaintenanceQueryService
    --
    +Create(resource : RegisterMachineResource, cancellationToken : CancellationToken) : Task<IActionResult>
    +ChangeStatus(id : long, resource : ChangeMachineStatusResource, cancellationToken : CancellationToken) : Task<IActionResult>
    +GetAll(cancellationToken : CancellationToken) : Task<IActionResult>
  }
  class MaintenanceRecordsController <<REST Controller>> {
    -commandService : IMaintenanceCommandService
    -queryService : IMaintenanceQueryService
    --
    +Create(resource : RecordMaintenanceResource, cancellationToken : CancellationToken) : Task<IActionResult>
    +GetHistory(machineId : long, cancellationToken : CancellationToken) : Task<IActionResult>
  }

  class RegisterMachineResource <<Request Resource>> <<(R,#FF7700)>> {
    +Code : string
    +Name : string
    +Model : string
  }
  class ChangeMachineStatusResource <<Request Resource>> <<(R,#FF7700)>> {
    +Status : string
    +ChangedAt : DateTimeOffset
  }
  class RecordMaintenanceResource <<Request Resource>> <<(R,#FF7700)>> {
    +MachineId : long
    +Type : string
    +PerformedAt : DateTimeOffset
    +Description : string
    +TechnicianId : long
    +TechnicianName : string
    +AnomalyId : long?
    +Failure : string?
    +Cause : string?
    +ActionTaken : string?
    +DowntimeMinutes : long?
  }
  class MachineResource <<Response Resource>> <<(R,#FF7700)>> {
    +Id : long
    +Code : string
    +Name : string
    +Model : string
    +Status : string
    +StatusChangedAt : DateTimeOffset
  }
  class MaintenanceRecordResource <<Response Resource>> <<(R,#FF7700)>> {
    +Id : long
    +MachineId : long
    +Type : string
    +PerformedAt : DateTimeOffset
    +Description : string
    +TechnicianId : long
    +TechnicianName : string
    +AnomalyId : long?
    +Failure : string?
    +Cause : string?
    +ActionTaken : string?
    +DowntimeMinutes : long?
  }

  class RegisterMachineCommandFromResourceAssembler <<Assembler>> {
    +{static} ToCommandFromResource(resource : RegisterMachineResource) : RegisterMachineCommand
  }
  class ChangeMachineStatusCommandFromResourceAssembler <<Assembler>> {
    +{static} ToCommandFromResource(machineId : long, resource : ChangeMachineStatusResource) : ChangeMachineStatusCommand
  }
  class RecordMaintenanceCommandFromResourceAssembler <<Assembler>> {
    +{static} ToCommandFromResource(resource : RecordMaintenanceResource) : RecordMaintenanceCommand
  }
  class MachineResourceFromEntityAssembler <<Assembler>> {
    +{static} ToResourceFromEntity(entity : Machine) : MachineResource
  }
  class MaintenanceRecordResourceFromEntityAssembler <<Assembler>> {
    +{static} ToResourceFromEntity(entity : MaintenanceRecord) : MaintenanceRecordResource
  }
}

package "Molinex.AssetMaintenanceManagement.Application" as Application {
  interface IMaintenanceCommandService <<Command Service>> {
    +Handle(command : RegisterMachineCommand, cancellationToken : CancellationToken) : Task<Result<MachineId>>
    +Handle(command : ChangeMachineStatusCommand, cancellationToken : CancellationToken) : Task<Result<MachineId>>
    +Handle(command : RecordMaintenanceCommand, cancellationToken : CancellationToken) : Task<Result<MaintenanceRecordId>>
  }
  interface IMaintenanceQueryService <<Query Service>> {
    +Handle(query : GetMachinesQuery, cancellationToken : CancellationToken) : Task<IEnumerable<Machine>>
    +Handle(query : GetMachineByIdQuery, cancellationToken : CancellationToken) : Task<Machine?>
    +Handle(query : GetMaintenanceHistoryQuery, cancellationToken : CancellationToken) : Task<IEnumerable<MaintenanceRecord>>
  }
  class MaintenanceCommandService <<Command Service>> {
    -machineRepository : IMachineRepository
    -maintenanceRepository : IMaintenanceRecordRepository
    -unitOfWork : IUnitOfWork
  }
  class MaintenanceQueryService <<Query Service>> {
    -machineRepository : IMachineRepository
    -maintenanceRepository : IMaintenanceRecordRepository
  }
}

